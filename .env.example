# Helpan AI Rail — example environment file.
# Copy to .env and fill in. NEVER commit .env to git.

# ----- service ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
PORT=3040
SERVICE_VERSION=0.1.0

# ----- database (Postgres 16, Supabase af-south-1 in non-dev) ---------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helpan_ai

# ----- HMAC auth -------------------------------------------------------------
# Rail prefix is locked to 'Helpan' (matches the Authorization header literal:
# `Helpan-HMAC-SHA256 app_id=..., signature=...`). Do not change.
AUTH_RAIL_PREFIX=Helpan
AUTH_TIMESTAMP_HEADER=x-helpan-timestamp
AUTH_TIMESTAMP_TOLERANCE_SECONDS=300

# ----- idempotency -----------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# ----- secrets envelope (placeholder) ---------------------------------------
# H-1: 'noop' returns plaintext. H-6/H-7 swaps to 'kms' or 'supabase-vault'.
SECRETS_ENVELOPE_PROVIDER=noop

# ----- LLM provider (open per Confirmation Memo §5.8; not used in H-1) ------
# LLM_PROVIDER=
# LLM_API_KEY=

# ----- Identiti customer-JWT trust (H-2) ------------------------------------
# Helpan AI verifies BearerCustomer tokens via Identiti's JWKS. RS256, kid
# in header. Issuer must equal the `iss` claim Identiti sets at signing time.
# Audience is the rail's own audience string per OpenAPI BearerCustomer.
IDENTITI_JWKS_URL=https://api.identiti.co.ke/.well-known/jwks.json
IDENTITI_JWT_ISSUER=https://api.identiti.co.ke
HELPAN_JWT_AUDIENCE=https://api.helpan.co.ke

# ----- Delegated-authority issuance — Identiti internal signing (H-3) --------
# Helpan AI never holds the DA signing key: it POSTs claims to Identiti's
# /v1/internal/sign (HMAC-authed). Leave IDENTITI_INTERNAL_SIGN_URL empty in
# environments that don't issue authorities — POST /v1/authorities then 503s.
# IDENTITI_INTERNAL_SIGN_URL=https://api.identiti.co.ke/v1/internal/sign
# IDENTITI_INTERNAL_HMAC_SECRET=helpan-ai-tenant-secret-at-identiti-32b-min
# HELPAN_INTERNAL_APP_ID=helpan_ai
# IDENTITI_TIMESTAMP_HEADER=x-identiti-timestamp
# JWT_DA_KID=helpan-da-2026-q2

# ----- Kafka (H-5) ----------------------------------------------------------
# Comma-separated broker list. Leave empty in dev to skip Kafka publishes;
# deep-health will report kafka=unavailable. Webhook fan-out still works.
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=helpan-ai-rail

# ----- Webhook fan-out (H-5) ------------------------------------------------
# Per-app webhook target URLs. Naming: HELPAN_WEBHOOK_URL_<APP_ID_UPPER>.
# When an app's URL is absent, matches still record but no delivery is queued.
# HELPAN_WEBHOOK_URL_LUNCHDROP=https://lunchdrop.example/webhooks/helpan
# HELPAN_WEBHOOK_URL_CHAPAA=https://chapaa.example/webhooks/helpan

# Worker-only env (read by src/workers/webhookDelivery/index.ts, not by the API process):
# WEBHOOK_HMAC_SECRET=at-least-32-bytes-of-shared-secret-here-please-x
# WEBHOOK_DELIVERY_POLL_MS=1000
# WEBHOOK_DELIVERY_BATCH_SIZE=25
